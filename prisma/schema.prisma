// ============================================================
//  VeltaCapital: database schema (Prisma)
//  This file describes the "shape" of your data. Each `model`
//  becomes a table in your Neon database. You do not need to write SQL.
//  Prisma turns this into the database for you.
// ============================================================

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ---- A person with an account ----
model User {
  gameState     Json?
  id            String   @id @default(cuid())   // unique id, auto-generated
  email         String   @unique                // their login email
  name          String?                         // display name (optional)
  credits       Int      @default(0)            // current credit balance
  createdAt     DateTime @default(now())

  emailVerified   DateTime?    // required by NextAuth adapter
  image           String?      // Google profile picture
  agreedToTermsAt DateTime?    // your 13+ / ToS gate
  accounts        Account[]
  sessions        Session[]

  // Legacy access fields remain temporarily so existing deployments can adopt
  // the free-access release without a destructive database migration.
  plan             String  @default("none")
  simRunsLeft      Int     @default(0)
  unlimitedSims    Boolean @default(false)
  canRedeem        Boolean @default(false)
  earnMult         Float   @default(1.0)
  advancedUnlocked Boolean @default(false)
  hasBadge         Boolean @default(false)  // redeemed the leaderboard badge


  // links to this user's other records
  scores        Score[]
  creditEvents  CreditEvent[]
  redemptions   Redemption[]
}

// ---- One played round of the prediction game ----
model Score {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  symbol      String                            // e.g. "AAPL"
  accuracy    Int                               // 0–100 overall
  direction   Int                               // 1 = correct, 0 = wrong
  roundIndex       Int?
  optionType       String?
  optionBudget     Float?
  optionStrike     Float?
  optionPremium    Float?
  optionClosingPrice Float?
  optionFinalValue Float?
  optionProfitLoss Float?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([accuracy])                           // for leaderboard sorting
}

// ---- An audit trail of every credit change (never edit credits directly) ----
model CreditEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Int                               // + earned, - spent
  reason      String                            // "learning_round" | "learning_redemption" ...
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ---- A reward the user redeemed credits for ----
model Redemption {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  rewardName  String
  creditCost  Int
  createdAt   DateTime @default(now())

  @@index([userId])
}


model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Legacy event identifiers are retained for compatibility with databases that
// handled payments before the free-access release. Runtime payment code is gone.
model ProcessedStripeEvent {
  id          String   @id
  processedAt DateTime @default(now())
}

// ---- ADD this model to your schema.prisma ----
// One weekly stock report. `published` lets you save drafts (false) and
// only show finished ones (true) to members.
model WeeklyReport {
  id          String   @id @default(cuid())
  ticker      String                       // e.g. "AAPL"
  title       String                       // headline for the week
  body        String   @db.Text            // the report text (long)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

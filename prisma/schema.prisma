// ============================================================
//  VeltaCapital — database schema (Prisma)
//  This file describes the "shape" of your data. Each `model`
//  becomes a table in your Neon database. You don't write SQL —
//  Prisma turns this into the database for you.
// ============================================================

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ---- A person with an account ----
model User {
  id            String   @id @default(cuid())   // unique id, auto-generated
  email         String   @unique                // their login email
  name          String?                         // display name (optional)
  credits       Int      @default(0)            // current credit balance
  createdAt     DateTime @default(now())

  emailVerified   DateTime?    // required by NextAuth adapter
  image           String?      // Google profile picture
  agreedToTermsAt DateTime?    // your 13+ / ToS gate
  accounts        Account[]
  sessions        Session[]

  plan          String   @default("none")   // none | trial | starter | standard | premium
  simRunsLeft   Int      @default(0)        // simulation runs remaining (bucket, not per-day)
  unlimitedSims Boolean  @default(false)    // premium
  canRedeem     Boolean  @default(false)    // standard and above
  earnMult      Float    @default(1.0)      // 1.5 for premium
  advancedUnlocked Boolean @default(false)  // redeemed the advanced module
  hasBadge         Boolean @default(false)  // redeemed the leaderboard badge


  // links to this user's other records
  scores        Score[]
  creditEvents  CreditEvent[]
  redemptions   Redemption[]
}

// ---- One played round of the prediction game ----
model Score {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  symbol      String                            // e.g. "AAPL"
  accuracy    Int                               // 0–100 overall
  direction   Int                               // 1 = correct, 0 = wrong
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([accuracy])                           // for leaderboard sorting
}

// ---- An audit trail of every credit change (never edit credits directly) ----
model CreditEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Int                               // + earned, - spent
  reason      String                            // "round_reward" | "purchase_grant" | "redemption" ...
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ---- A reward the user redeemed credits for ----
model Redemption {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  rewardName  String
  creditCost  Int
  createdAt   DateTime @default(now())

  @@index([userId])
}


model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}